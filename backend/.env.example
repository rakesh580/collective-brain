# === LLM Provider ===
CB_LLM_PROVIDER=ollama                          # ollama | claude | mistral
CB_CLAUDE_API_KEY=                               # Required if provider=claude
CB_CLAUDE_MODEL=claude-sonnet-4-20250514
CB_OLLAMA_BASE_URL=http://localhost:11434
CB_OLLAMA_MODEL=llama3.1:8b
CB_MISTRAL_API_KEY=                              # Required if provider=mistral (HuggingFace token)
CB_MISTRAL_MODEL=Qwen/Qwen2.5-72B-Instruct

# === Agent Mode ===
CB_AGENT_MODE=rag                                # rag | langgraph
CB_AGENT_MAX_ITERATIONS=10

# === JWT Auth ===
CB_JWT_SECRET=change-this-to-a-random-secret     # IMPORTANT: change in production
CB_JWT_ALGORITHM=HS256
CB_JWT_EXPIRE_MINUTES=1440

# === Google OAuth ===
CB_GOOGLE_CLIENT_ID=                             # Google Cloud Console OAuth 2.0 Client ID

# === Embeddings ===
CB_EMBEDDING_MODEL=all-MiniLM-L6-v2
CB_EMBEDDING_DIMENSION=384

# === Database (PostgreSQL recommended for production) ===
CB_DATABASE_URL=postgresql://cb_user:cb_pass_change_me@localhost:5432/collective_brain
# For local dev without PostgreSQL, comment above and uncomment:
# CB_DATABASE_URL=
# CB_SQLITE_URL=sqlite:///./data/collective_brain.db

# === ChromaDB ===
CB_CHROMA_PERSIST_DIR=./data/chroma_db

# === Redis (optional) ===
CB_REDIS_URL=                                    # redis://localhost:6379/0

# === Chunking ===
CB_CHUNK_SIZE=512
CB_CHUNK_OVERLAP=64

# === RAG ===
CB_RETRIEVAL_TOP_K=8
CB_CONTEXT_MAX_TOKENS=3000
