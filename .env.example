# ─────────────────────────────────────────────────────────────
# Collective Brain — Environment Variables Template
# Copy this file to backend/.env and fill in your values.
# NEVER commit .env to git — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────

# ── Supabase credentials ──────────────────────────────────────
# Get these from: supabase.com → project → Settings → API
CB_SUPABASE_URL=https://<project-ref>.supabase.co
CB_SUPABASE_ANON_KEY=<anon-public-key>
CB_SUPABASE_SERVICE_KEY=<service-role-secret-key>

# ── Database URLs ─────────────────────────────────────────────
# Transaction pooler (port 6543) — used at RUNTIME by the app
CB_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Direct session connection (port 5432) — used ONLY by Alembic migrations
CB_MIGRATION_DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ── Auth & Security ───────────────────────────────────────────
# Generate with: openssl rand -base64 64
CB_JWT_SECRET=

# ── LLM Provider ─────────────────────────────────────────────
# Options: mistral | claude | ollama
CB_LLM_PROVIDER=mistral
CB_MISTRAL_API_KEY=
CB_MISTRAL_MODEL=Qwen/Qwen2.5-72B-Instruct
CB_CLAUDE_API_KEY=
CB_CLAUDE_MODEL=claude-sonnet-4-20250514
CB_OLLAMA_BASE_URL=http://localhost:11434
CB_OLLAMA_MODEL=llama3.1:8b

# ── Agent Mode ────────────────────────────────────────────────
CB_AGENT_MODE=rag

# ── Google OAuth (optional) ───────────────────────────────────
CB_GOOGLE_CLIENT_ID=

# ── Embeddings ────────────────────────────────────────────────
CB_EMBEDDING_MODEL=all-MiniLM-L6-v2
CB_EMBEDDING_DIMENSION=384

# ── RAG Tuning ────────────────────────────────────────────────
CB_CHUNK_SIZE=512
CB_CHUNK_OVERLAP=64
CB_RETRIEVAL_TOP_K=8
CB_CONTEXT_MAX_TOKENS=3000

# ── Redis (optional, in-memory fallback when not set) ─────────
CB_REDIS_URL=

# ── Slack Bot Integration (optional) ─────────────────────────
CB_SLACK_CLIENT_ID=
CB_SLACK_CLIENT_SECRET=
CB_SLACK_SIGNING_SECRET=

# ── GitHub Webhook (optional) ────────────────────────────────
CB_GITHUB_WEBHOOK_SECRET=

# ── Dev / Demo ────────────────────────────────────────────────
CB_DEV_MODE=1
CB_LOG_LEVEL=INFO
