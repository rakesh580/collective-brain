# Docker Compose environment variables
# Copy this file to .env and fill in your values
# IMPORTANT: Use strong, randomly generated values for all secrets

CB_POSTGRES_PASSWORD=    # Required — use: openssl rand -base64 32
CB_REDIS_PASSWORD=       # Required — use: openssl rand -base64 32
CB_JWT_SECRET=           # Required — use: openssl rand -base64 64
CB_LLM_PROVIDER=ollama
CB_OLLAMA_BASE_URL=http://host.docker.internal:11434
CB_CLAUDE_API_KEY=
CB_MISTRAL_API_KEY=
CB_GOOGLE_CLIENT_ID=
CB_AGENT_MODE=rag
